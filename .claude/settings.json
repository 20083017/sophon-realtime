      "Bash(python3 scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(.claude/tools/*)",
      "Bash(bash .claude/tools/*)",
      "Bash(tail *)",
      "Bash(journalctl *)",
      "Bash(systemctl *)",
      "Agent(sophon-plan)",
      "Agent(worktree-manager)",
      "Agent(sophon-architecture-calibrator)",
      "Agent(sophon-shell-tooling)",
      "Agent(sophon-python-tooling)",
      "Agent(sophon-python-dev)",
      "Agent(sophon-code-review)",
      "Agent(sophon-server-operator)",
      "Bash",
